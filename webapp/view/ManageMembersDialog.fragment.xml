<core:FragmentDefinition
    xmlns:core="sap.ui.core"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">
    <Dialog
        id="manageMembersDialog"
        title="{i18n>dialogManageMembers}"
        type="Standard">
        <content>
            <VBox class="sapUiSmallMargin">
                <MessageStrip
                    text="{i18n>membersDialogMessage}"
                    type="Information"
                    showIcon="true"
                    class="sapUiSmallMarginBottom" />

                <IconTabBar
                    id="membersIconTabBar"
                    expanded="true"
                    class="sapUiResponsiveContentPadding"
                    select="onMembersTabSelect">
                    <items>
                        <IconTabFilter text="{i18n>activeMembersTitle}" icon="sap-icon://person-placeholder" key="active">
                            <content>
                                <List
                                    id="activeMembersList"
                                    items="{view>/activeMembers}"
                                    mode="None"
                                    class="sapUiSmallMargin">
                                    <StandardListItem
                                        title="{view>name}"
                                        description="{view>email}"
                                        icon="sap-icon://person-placeholder"
                                        type="Inactive" />
                                </List>
                            </content>
                        </IconTabFilter>

                        <IconTabFilter text="{i18n>pendingMembersTitle}" icon="sap-icon://person" key="pending">
                            <content>
                                <List
                                    id="pendingMembersList"
                                    items="{view>/pendingMembers}"
                                    mode="None"
                                    class="sapUiSmallMargin">
                                    <StandardListItem
                                        title="{view>name}"
                                        description="{view>email}"
                                        icon="sap-icon://person"
                                        type="Inactive" />
                                </List>
                            </content>
                        </IconTabFilter>
                    </items>
                </IconTabBar>
            </VBox>
        </content>
        <beginButton>
            <Button
                text="{i18n>btnSave}"
                type="Emphasized"
                press="onSaveMembers" />
        </beginButton>
        <endButton>
            <Button
                text="{i18n>btnCancel}"
                press="onCancelDialog" />
        </endButton>
    </Dialog>
</core:FragmentDefinition>
