<core:FragmentDefinition
    xmlns:core="sap.ui.core"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">
    <Dialog
        id="manageMembersDialog"
        title="{i18n>manageMembersTitle}"
        type="Standard"
        contentWidth="250px"
            verticalScrolling="false"
    horizontalScrolling="false"
        resizable="true">
        <content>
            <VBox class="sapUiSmallMargin">
                <MessageStrip
                    text="Open first tab to view contents in tab1 and second tab to view contents in tab 2 after checking list please close the tab"
                    type="Information"
                    showIcon="true"
                    class="sapUiSmallMarginBottom" />
            </VBox>
            <VBox fitContainer="true">
                <IconTabBar
                    id="membersIconTabBar"
                    expanded="true"
                    class="sapUiResponsiveContentPadding"
                    select="onMembersTabSelect"
                    height="100%">
                    <items>
                        <IconTabFilter text="{i18n>tabActiveMembers}" icon="sap-icon://person-placeholder" key="active">
                            <content>
                                <List
                                    id="activeMembersList"
                                    items="{view>/activeMembers}"
                                    mode="None"
                                    class="sapUiSmallMargin"
                                    height="270px">
                                    <StandardListItem
                                        title="{view>name}"
                                        description="{view>email}"
                                        icon="sap-icon://person-placeholder"
                                        type="Inactive" />
                                </List>
                            </content>
                        </IconTabFilter>

                        <IconTabFilter text="{i18n>tabPendingMembers}" icon="sap-icon://person" key="pending">
                            <content>
                                <List
                                    id="pendingMembersList"
                                    items="{view>/pendingMembers}"
                                    mode="None"
                                    class="sapUiSmallMargin"
                                    height="270px">
                                    <StandardListItem
                                        title="{view>name}"
                                        description="{view>email}"
                                        icon="sap-icon://person"
                                        type="Inactive" />
                                </List>
                            </content>
                        </IconTabFilter>
                    </items>
                </IconTabBar>
            </VBox>
        </content>
        <beginButton>
            <Button
                text="{i18n>btnSave}"
                type="Emphasized"
                press="onSaveMembers" />
        </beginButton>
        <endButton>
            <Button
                text="{i18n>btnCancel}"
                press="onCancelDialog" />
        </endButton>
    </Dialog>
</core:FragmentDefinition>
